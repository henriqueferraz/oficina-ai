SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Produção (HTTPS): CSRF_TRUSTED_ORIGINS=https://seu-dominio.com,https://www.seu-dominio.com
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Reuso de conexão Postgres (Neon). Em serverless use 0.
CONN_MAX_AGE=60
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=whisper-1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True
DEFAULT_FROM_EMAIL=oficina-ai@localhost
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Cloudflare R2 (S3-compatible) — fotos de orçamento
# Sem AWS_STORAGE_BUCKET_NAME → usa disco local (media/)
# IMPORTANTE: o nome deve ser exatamente o bucket criado no painel R2
AWS_STORAGE_BUCKET_NAME=hferraz
AWS_S3_REGION_NAME=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Endpoint do painel R2 → Overview → S3 API (sem /nome-do-bucket no final)
AWS_S3_ENDPOINT_URL=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
# Domínio público (Custom Domain ou r2.dev). Sem https://
AWS_S3_CUSTOM_DOMAIN=
# True = URLs assinadas (bucket privado). False = leitura pública via custom domain.
AWS_QUERYSTRING_AUTH=True
AWS_S3_ADDRESSING_STYLE=path

# Portal (links públicos em e-mails / WhatsApp)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# WhatsApp Cloud API (Meta) — opcional
WHATSAPP_VERIFY_TOKEN=oficina-ai-verify
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DEFAULT_OFICINA_ID=
WHATSAPP_DRY_RUN=True

# n8n + Evolution API — a credencial da Evolution fica somente no n8n.
# N8N_INBOUND_SECRET assina eventos e callbacks enviados pelo n8n ao Django.
# N8N_OUTBOUND_SECRET assina comandos enviados pelo Django ao n8n.
N8N_INBOUND_SECRET=
N8N_OUTBOUND_SECRET=
N8N_OUTBOUND_URL=
N8N_EVOLUTION_INSTANCE=
N8N_WEBHOOK_MAX_AGE_SECONDS=300
N8N_MAX_MEDIA_BYTES=8388608
